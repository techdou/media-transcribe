# ===== Qwen3-ASR 转录环境配置 =====
# 复制本文件为 .env 并填写本机路径（.env 已被 .gitignore 忽略，不会入库）
# 优先级：命令行参数 > 系统环境变量 > 本文件

# 引擎源码目录（HaujetZhao/Qwen3-ASR-GGUF 解压后的 engine 目录）
QWEN3_ASR_ENGINE_DIR=

# 模型目录（含 qwen3_asr_* 与 qwen3_aligner_* 模型文件）
QWEN3_ASR_MODEL_DIR=

# 可选：断点续传下载监视器脚本路径（SKILL.md「常见坑」引用）
QWEN3_DOWNLOAD_WATCHER=
